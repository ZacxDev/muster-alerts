# Copy to .env and fill in. Placeholders only: never commit a real secret.

# muster's address: https://, or http:// to localhost / 127.0.0.1 / [::1] only.
MUSTER_URL=https://muster.example.com

# The plugin token (mpl_…), shown once when you create the plugin on muster's
# /plugins page. It opens muster's /plugin/v1/* routes only, acting as you.
MUSTER_PLUGIN_TOKEN=mpl_replace_me

# The shared secret every webhook must carry, at least 16 characters
# (e.g. `openssl rand -hex 32`). Send it as X-Muster-Alerts-Secret, or as
# "Authorization: Bearer <secret>".
ALERTS_SECRET=replace_me_with_a_long_random_secret

# Optional: where the webhooks are served (default 127.0.0.1:9095). A
# non-loopback address also needs ALERTS_ALLOW_NON_LOOPBACK=1 (the webhook is
# plain HTTP). Left commented out on purpose: under `docker run --env-file` a
# value here would override the image's ALERTS_LISTEN=0.0.0.0:9095, and the
# container would listen on its own loopback, unreachable through -p. For the
# container, pass -e ALERTS_ALLOW_NON_LOOPBACK=1 on the command line instead
# (README, "Docker").
# ALERTS_LISTEN=127.0.0.1:9095
# ALERTS_ALLOW_NON_LOOPBACK=1

# Optional: the task key namespace; it must be in muster's
# MUSTER_PLUGIN_TASK_NAMESPACES. Default alert.
ALERTS_TASK_NAMESPACE=alert

# Optional: how fast the plugin calls muster (requests an hour, and a burst).
# Default 60 and 10. Every firing alert group is a task routed to your chief:
# lower it (e.g. 12) if your alerts are noisy.
ALERTS_MAX_PER_HOUR=60
ALERTS_BURST=10

# Optional: past this many events still waiting for muster, a NEW alert is
# answered 503 (Alertmanager sends it again later).
ALERTS_MAX_PENDING=500

# Optional: where the outbox and the open episodes live (default ./state). Keep
# it across restarts: it is what stops a repeat notification filing a second
# task. Left commented out on purpose: under `docker run --env-file` it would
# override the image's STATE_DIR=/state, and the state would be lost with the
# container.
# STATE_DIR=./state
